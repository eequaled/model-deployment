# Weights, datasets, and model binaries generated by export/ never belong in git.
# GitHub rejects files over 100 MB, and every model file here is reproducible from
# export/export_onnx.py against the original checkpoint.

*.onnx
*.onnx.data
*.bin
*.safetensors
*.pth
*.pt

.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

models/
data/
samples/*
!samples/.gitkeep
!samples/example.png
*.log
bench/*.json
results/

# The Triton comparison lab lives outside version control on purpose. Triton
# Inference Server is explicitly forbidden in the submission (challenge.md:
# "No prebuilt ML serving servers"), so everything under triton-lab/ is an
# out-of-tree experiment: same graphs, same CPU envelope, different server.
# Committed results from it belong in journal.md as quoted numbers, not as files.
triton-lab/

.env
.DS_Store
